# 综合办公智能体 UOS/统信/Kylin/麒麟 x86_64 .deb 构建环境
#
# 基于 Debian 10 (buster, GLIBC 2.28)，与 UOS 20 GLIBC 完全兼容。
# 纯 Linux 原生构建（无 Wine）。
#
# 镜像构建:
#   docker-compose -f docker/docker-compose.uos.yml build
#
# 一键构建:
#   docker-compose -f docker/docker-compose.uos.yml run --rm build

FROM debian:10-slim

LABEL maintainer="Baize Team <dev@baize.app>"
LABEL description="Build environment for Baize UOS/Kylin .deb packages"

ARG UID=1000
ARG GID=1000

ENV DEBIAN_FRONTEND=noninteractive

# Debian 10 (buster) 已归档，使用 archive.debian.org
RUN echo "deb http://archive.debian.org/debian/ buster main contrib non-free" > /etc/apt/sources.list \
    && echo "deb http://archive.debian.org/debian-security buster/updates main contrib non-free" >> /etc/apt/sources.list \
    && echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until

# Step 1: ca-certificates (用于后续 HTTPS 下载 Node.js)
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Step 2: 系统依赖 (编译工具 + Electron 运行时库)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    python3 \
    git \
    curl \
    xz-utils \
    p7zip-full \
    file \
    libnss3 \
    libnspr4 \
    libatk1.0-0 \
    libatk-bridge2.0-0 \
    libcups2 \
    libdrm2 \
    libxcomposite1 \
    libxdamage1 \
    libxrandr2 \
    libgbm1 \
    libpango-1.0-0 \
    libcairo2 \
    libasound2 \
    && rm -rf /var/lib/apt/lists/*

# Step 3: Node.js 22.22.0 + npm 11.11.1 (中国镜像)
RUN curl -fsSL https://npmmirror.com/mirrors/node/v22.22.0/node-v22.22.0-linux-x64.tar.xz \
    | tar -xJ -C /usr/local --strip-components=1 \
    && npm install -g npm@11.11.1 --registry=https://registry.npmmirror.com

# Step 4: 非 root 构建用户 (匹配宿主 UID/GID)
RUN groupadd -g ${GID} builder \
    && useradd -m -u ${UID} -g ${GID} -s /bin/bash builder

# Step 5: 缓存目录 (与宿主共享，避免重复下载)
RUN mkdir -p /home/builder/.cache/electron \
       /home/builder/.cache/electron-builder \
       /home/builder/.npm \
    && chown -R builder:builder /home/builder

# Step 6: 中国镜像环境变量
ENV ELECTRON_MIRROR=https://npmmirror.com/mirrors/electron/
ENV ELECTRON_BUILDER_BINARIES_MIRROR=https://npmmirror.com/mirrors/electron-builder-binaries/
ENV npm_config_registry=https://registry.npmmirror.com
ENV NODE_OPTIONS=--max-old-space-size=4096

# 强制从源码重编 better-sqlite3，链接容器内 GLIBC 2.28，确保 UOS/Kylin 兼容
ENV REBUILD_NATIVE=1

WORKDIR /app

USER builder

CMD ["node", "scripts/build-linux-deb.mjs"]
